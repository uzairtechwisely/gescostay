NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_GA_ID=G-QKFTVS6K4E
LEAD_WEBHOOK_URL=https://your-webhook-endpoint.example.com/gesco-stay-leads

# Email (Resend) — sends a confirmation email to the lead and a notification
# email to your team on every form/modal submission. Without RESEND_API_KEY,
# email sending is skipped (submissions still work via webhook/database).
RESEND_API_KEY=re_your_api_key
LEAD_NOTIFICATION_EMAIL=hello@gescostay.com
# Until a domain is verified on Resend, the sandbox sender below can only
# deliver to the email address the Resend account was created with.
EMAIL_FROM="GescoStay <onboarding@resend.dev>"

# Subdomain labels routed by proxy.ts to their dedicated landing page.
# Defaults to "lagos-hosts" / "lagos-travel" if unset.
NEXT_PUBLIC_LAGOS_HOSTS_SUBDOMAIN=lagos-hosts
NEXT_PUBLIC_LAGOS_TRAVEL_SUBDOMAIN=lagos-travel
